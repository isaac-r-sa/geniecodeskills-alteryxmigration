      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxJoin" />
    </Node>

    <!-- 19. Running Total: cumulative store sales -->
    <Node ToolID="19">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RunningTotal.RunningTotal">
        <Position x="2390" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <GroupByFields>
            <Field field="store_id" />
          </GroupByFields>
          <RunningTotalFields>
