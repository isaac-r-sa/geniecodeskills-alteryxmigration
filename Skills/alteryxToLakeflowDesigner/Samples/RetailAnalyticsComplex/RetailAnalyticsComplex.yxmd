<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>

    <!-- 1. Input Data: Transactions CSV -->
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">/Volumes/aldi_aus/demo/raw_test/transactions.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <Delimeter>,</Delimeter>
            <IgnoreErrors>False</IgnoreErrors>
            <FieldLen>2147483647</FieldLen>
            <AllowShareWrite>False</AllowShareWrite>
            <ImportLine>1</ImportLine>
            <CodePage>65001</CodePage>
            <QuoteOutputFields>NewLinesAndQuotes</QuoteOutputFields>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Input Transactions</Name>
          <DefaultAnnotationText>Raw transactions.csv (20M rows)</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- 2. Input Data: Product Catalog CSV -->
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="200" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">/Volumes/aldi_aus/demo/raw_test/product_catalog.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <Delimeter>,</Delimeter>
            <IgnoreErrors>False</IgnoreErrors>
            <FieldLen>2147483647</FieldLen>
            <CodePage>65001</CodePage>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Input Product Catalog</Name>
          <DefaultAnnotationText>product_catalog.csv</DefaultAnnotationText>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- 3. Input Data: Store dim -->
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="340" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">/Volumes/aldi_aus/demo/raw_test/stores.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <Delimeter>,</Delimeter>
            <CodePage>65001</CodePage>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Input Stores</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- 4. Filter: Keep last 24 months of data and amount > 0 -->
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="200" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Mode>Custom</Mode>
          <Expression>[transaction_date] &gt;= DateTimeAdd(DateTimeToday(),-24,"months") AND ToNumber([quantity]) &gt; 0</Expression>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Filter Recent + Positive Qty</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFilter" />
    </Node>

    <!-- 5. DateTime: Parse transaction_date string -> DateTime -->
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DateTime.DateTime">
        <Position x="346" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <IsFrom>True</IsFrom>
          <InputFieldName>transaction_date</InputFieldName>
          <OutputFieldName>txn_date_parsed</OutputFieldName>
          <Format>yyyy-MM-dd HH:mm:ss</Format>
          <Language>English</Language>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Parse Date</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDateTime" />
    </Node>

    <!-- 6. Formula: Derive net_amount, year, month, weekday, is_weekend -->
    <Node ToolID="6">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="492" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="ToNumber([quantity]) * ToNumber([unit_price]) * (1 - ToNumber([discount_pct]))" field="net_amount" size="8" type="Double" />
            <FormulaField expression="DateTimeYear([txn_date_parsed])" field="txn_year" size="4" type="Int32" />
            <FormulaField expression="DateTimeMonth([txn_date_parsed])" field="txn_month" size="4" type="Int32" />
            <FormulaField expression="DateTimeFormat([txn_date_parsed], '%A')" field="txn_weekday" size="32" type="V_WString" />
            <FormulaField expression="IIF(DateTimeFormat([txn_date_parsed], '%a') IN ('Sat','Sun'), 1, 0)" field="is_weekend" size="4" type="Int32" />
            <FormulaField expression="Uppercase(Trim([payment_method]))" field="payment_method_clean" size="32" type="V_WString" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Derive Net Amount + Date Parts</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <!-- 7. RegEx: Parse product_code like "ABC-1234-XYZ" -> category, sku, variant -->
    <Node ToolID="7">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RegEx.RegEx">
        <Position x="638" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Field>product_code</Field>
          <CaseInsensitive>True</CaseInsensitive>
          <Method>ParseSimple</Method>
          <Expression>^([A-Z]{2,4})-(\d{3,5})-([A-Z0-9]{2,4})$</Expression>
          <ParseSimple>
            <FieldList>
              <Field name="pc_category" size="16" type="V_WString" />
              <Field name="pc_sku" size="16" type="V_WString" />
              <Field name="pc_variant" size="16" type="V_WString" />
            </FieldList>
          </ParseSimple>
          <ErrorHandling>0</ErrorHandling>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>RegEx Parse Product Code</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxRegEx" />
    </Node>

    <!-- 8. Text To Columns: Split customer_name "Last, First" -> last, first -->
    <Node ToolID="8">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextToColumns.TextToColumns">
        <Position x="784" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Field>customer_name</Field>
          <Delimeters Token="False">,</Delimeters>
          <SplitMethod>Columns</SplitMethod>
          <NumFields>2</NumFields>
          <RootName>cust_name_part</RootName>
          <ExtraChars>LeaveExtraInLastField</ExtraChars>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Split Customer Name</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTextToColumns" />
    </Node>

    <!-- 9. Multi-Field Formula: TrimAll string fields -->
    <Node ToolID="9">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiFieldFormula.MultiFieldFormula">
        <Position x="930" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Type>String</Type>
          <ChangeFieldTypes>False</ChangeFieldTypes>
          <Fields>
            <Field name="cust_name_part1" selected="True" />
            <Field name="cust_name_part2" selected="True" />
            <Field name="payment_method_clean" selected="True" />
          </Fields>
          <Expression>TrimLeft(TrimRight([_CurrentField_]))</Expression>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Trim All Strings</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiFieldFormula" />
    </Node>

    <!-- 10. Join: transactions <-> product_catalog on product_id -->
    <Node ToolID="10">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Join.Join">
        <Position x="1076" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration joinByRecordPos="False">
          <JoinInfo connection="Left">
            <Field field="product_id" />
          </JoinInfo>
          <JoinInfo connection="Right">
            <Field field="product_id" />
          </JoinInfo>
          <SelectConfiguration>
            <Configuration outputConnection="Join">
              <OrderChanged value="False" />
              <CommaDecimal value="False" />
              <SelectFields>
                <SelectField field="*Unknown" selected="True" />
              </SelectFields>
            </Configuration>
          </SelectConfiguration>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Join Products</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxJoin" />
    </Node>

    <!-- 11. Find Replace: standardize product_name from lookup table -->
    <Node ToolID="11">
      <GuiSettings Plugin="AlteryxBasePluginsGui.FindReplace.FindReplace">
        <Position x="1222" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FindWithinField>product_name</FindWithinField>
          <FindWhere>WholeString</FindWhere>
          <FindFieldRef>product_name_old</FindFieldRef>
          <ReplaceWith>True</ReplaceWith>
          <ReplaceFieldRef>product_name_new</ReplaceFieldRef>
          <CaseSensitive>False</CaseSensitive>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Standardize Product Names</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFindReplace" />
    </Node>

    <!-- 12. Imputation: fill missing unit_price with median -->
    <Node ToolID="12">
      <GuiSettings Plugin="Imputation_v3">
        <Position x="1368" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Fields>
            <Field name="unit_price" />
          </Fields>
          <IncomingValue type="Null" />
          <ReplaceValue type="Median" />
          <AddIndicator>True</AddIndicator>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Impute Missing Prices</Name>
        </Annotation>
      </Properties>
    </Node>

    <!-- 13. Append Fields: cross-join with currency rates (1-row lookup) -->
    <Node ToolID="13">
      <GuiSettings Plugin="AlteryxBasePluginsGui.AppendFields.AppendFields">
        <Position x="1514" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SelectConfiguration>
            <Configuration>
              <OrderChanged value="False" />
              <SelectFields>
                <SelectField field="*Unknown" selected="True" />
              </SelectFields>
            </Configuration>
          </SelectConfiguration>
          <WarnOnSizeLimit>16</WarnOnSizeLimit>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Append FX Rates</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxAppendFields" />
    </Node>

    <!-- 14. Sort: by customer_id, txn_date_parsed -->
    <Node ToolID="14">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sort.Sort">
        <Position x="1660" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SortInfo>
            <Field field="customer_id" order="Ascending" />
            <Field field="txn_date_parsed" order="Ascending" />
          </SortInfo>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Sort by Customer, Date</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxSort" />
    </Node>

    <!-- 15. Multi-Row Formula: running customer balance and days_since_prev_txn -->
    <Node ToolID="15">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiRowFormula.MultiRowFormula">
        <Position x="1806" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <UpdateField>False</UpdateField>
          <CreateField>True</CreateField>
          <CreateFieldName>cust_running_total</CreateFieldName>
          <CreateFieldType>Double</CreateFieldType>
          <CreateFieldSize>8</CreateFieldSize>
          <GroupByFields>
            <Field field="customer_id" />
          </GroupByFields>
          <NumRows>1</NumRows>
          <ValuesForRowsThatDontExist>NULL</ValuesForRowsThatDontExist>
          <Expression>IIF(IsNull([Row-1:cust_running_total]), [net_amount], [Row-1:cust_running_total] + [net_amount])</Expression>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Running Customer Total</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiRowFormula" />
    </Node>

    <!-- 16. Unique: dedupe on transaction_id -->
    <Node ToolID="16">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Unique.Unique">
        <Position x="1952" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <UniqueFields>
            <Field field="transaction_id" />
          </UniqueFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Dedupe Txn IDs</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxUnique" />
    </Node>

    <!-- 17. Tile: bucket customers into deciles by cust_running_total -->
    <Node ToolID="17">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Tile.Tile">
        <Position x="2098" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Method>EqualRecords</Method>
          <NumTiles>10</NumTiles>
          <SortField field="cust_running_total" order="Descending" />
          <TileFieldName>customer_decile</TileFieldName>
          <SequenceFieldName>customer_decile_seq</SequenceFieldName>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Customer Decile</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTile" />
