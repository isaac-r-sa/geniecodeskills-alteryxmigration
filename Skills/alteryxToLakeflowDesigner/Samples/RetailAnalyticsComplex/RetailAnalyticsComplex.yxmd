        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxRunningTotal" />
    </Node>

    <!-- 20. Summarize: aggregate to store/category/month -->
    <Node ToolID="20">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Summarize.Summarize">
        <Position x="2536" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SummarizeFields>
            <SummarizeField field="store_id" action="GroupBy" />
            <SummarizeField field="store_region" action="GroupBy" />
            <SummarizeField field="pc_category" action="GroupBy" />
            <SummarizeField field="txn_year" action="GroupBy" />
            <SummarizeField field="txn_month" action="GroupBy" />
            <SummarizeField field="transaction_id" action="Count" rename="txn_count" />
            <SummarizeField field="customer_id" action="CountDistinct" rename="unique_customers" />
            <SummarizeField field="net_amount" action="Sum" rename="total_revenue" />
            <SummarizeField field="net_amount" action="Avg" rename="avg_basket" />
            <SummarizeField field="net_amount" action="Min" rename="min_amount" />
            <SummarizeField field="net_amount" action="Max" rename="max_amount" />
            <SummarizeField field="quantity" action="Sum" rename="total_units" />
          </SummarizeFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Aggregate to Store/Category/Month</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxSummarize" />
    </Node>

    <!-- 21. Cross Tab: pivot category vs month -->
    <Node ToolID="21">
      <GuiSettings Plugin="AlteryxBasePluginsGui.CrossTab.CrossTab">
        <Position x="2682" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <GroupFields>
            <Field field="store_id" />
            <Field field="store_region" />
            <Field field="pc_category" />
          </GroupFields>
          <HeaderField field="txn_month" />
          <DataField field="total_revenue" />
          <Methods>
            <Method method="Sum" />
          </Methods>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Pivot Revenue by Month</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxCrossTab" />
