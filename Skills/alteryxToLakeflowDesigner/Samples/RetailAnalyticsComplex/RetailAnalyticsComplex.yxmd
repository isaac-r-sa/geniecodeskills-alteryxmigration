          <SelectFields>
            <SelectField field="store_id" selected="True" rename="store_id" />
            <SelectField field="store_region" selected="True" rename="region" />
            <SelectField field="pc_category" selected="True" rename="category" />
            <SelectField field="txn_year" selected="True" rename="year" />
