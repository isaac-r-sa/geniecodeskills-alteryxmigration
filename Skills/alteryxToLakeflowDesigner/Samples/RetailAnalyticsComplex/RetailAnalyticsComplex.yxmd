    <!-- 22. Transpose: wide store-month back to long for reporting -->
    <Node ToolID="22">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Transpose.Transpose">
        <Position x="2828" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <KeyFields>
            <Field field="store_id" />
            <Field field="store_region" />
            <Field field="pc_category" />
          </KeyFields>
          <DataFields>
            <Field field="*Unknown" selected="True" />
          </DataFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Transpose Back to Long</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTranspose" />
    </Node>

    <!-- 23. Generate Rows: build date dimension 2024-01-01 -> 2026-12-31 -->
    <Node ToolID="23">
      <GuiSettings Plugin="AlteryxBasePluginsGui.GenerateRows.GenerateRows">
        <Position x="200" y="500" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <InitField name="cal_date" type="Date" size="10">
            <InitExpression>'2024-01-01'</InitExpression>
          </InitField>
          <LoopExpression>DateTimeAdd([cal_date], 1, 'days')</LoopExpression>
          <ConditionExpression>[cal_date] &lt;= '2026-12-31'</ConditionExpression>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Generate Date Dimension</Name>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxGenerateRows" />
    </Node>

    <!-- 24. Union: combine summary + transposed result -->
    <Node ToolID="24">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Union.Union">
        <Position x="2974" y="100" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Mode>Auto</Mode>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Union Summary Streams</Name>
        </Annotation>
