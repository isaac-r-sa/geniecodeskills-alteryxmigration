    <!-- 30. Text Input: product-name standardization mapping for Find Replace -->
    <Node ToolID="30">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput">
        <Position x="900" y="500" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <NumRows value="4" />
