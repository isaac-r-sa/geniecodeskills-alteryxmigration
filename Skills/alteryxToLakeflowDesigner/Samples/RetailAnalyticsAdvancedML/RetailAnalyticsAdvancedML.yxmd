<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>

    <!-- ============================================================ -->
    <!-- CONTAINER 1: Ingest + Initial Cleansing                       -->
    <!-- ============================================================ -->
    <Node ToolID="100">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="30" y="30" width="900" height="540" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>1. Ingest &amp; Cleanse</Caption>
          <Style TextColor="#314c4a" FillColor="#d4e8e8" BorderColor="#314c4a" Transparency="50" Margin="25" />
          <Disabled value="False" />
          <Folded value="False" />
        </Configuration>
        <Annotation DisplayMode="0" />
      </Properties>
      <ChildNodes>
        <Node ToolID="1" />
        <Node ToolID="2" />
        <Node ToolID="3" />
        <Node ToolID="4" />
        <Node ToolID="5" />
        <Node ToolID="6" />
        <Node ToolID="7" />
      </ChildNodes>
    </Node>

    <!-- 1. Input: transactions -->
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="60" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">/Volumes/aldi_aus/demo/raw_test/transactions.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <Delimeter>,</Delimeter>
            <CodePage>65001</CodePage>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Input Transactions (20M)</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- 2. Input: product catalog -->
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="60" y="200" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">/Volumes/aldi_aus/demo/raw_test/product_catalog.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <Delimeter>,</Delimeter>
            <CodePage>65001</CodePage>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Input Product Catalog</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- 3. Input: stores -->
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="60" y="320" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="25">/Volumes/aldi_aus/demo/raw_test/stores.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <Delimeter>,</Delimeter>
            <CodePage>65001</CodePage>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Input Stores</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>

    <!-- 4. Record ID: add row_id -->
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RecordID.RecordID">
        <Position x="200" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FieldName>row_id</FieldName>
          <StartValue>1</StartValue>
          <FieldType>Int64</FieldType>
          <FieldSize>8</FieldSize>
          <Position>Beginning</Position>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Add Record ID</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxRecordID" />
    </Node>

    <!-- 5. Auto Field: optimize field types -->
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.AutoField.AutoField">
        <Position x="320" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Fields>
            <Field name="*Unknown" selected="True" />
          </Fields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Auto Field</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxAutoField" />
    </Node>

    <!-- 6. Data Cleansing: remove special chars, normalize case -->
    <Node ToolID="6">
      <GuiSettings Plugin="DataCleansing_v3">
        <Position x="440" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Fields>
            <Field name="customer_name" selected="True" />
            <Field name="payment_method" selected="True" />
          </Fields>
          <RemoveNullRows>False</RemoveNullRows>
          <RemoveNullColumns>False</RemoveNullColumns>
          <ReplaceNulls>True</ReplaceNulls>
          <ReplaceNullsWith />
          <RemoveWhitespace>True</RemoveWhitespace>
          <RemoveDuplicateWhitespace>True</RemoveDuplicateWhitespace>
          <RemoveLetters>False</RemoveLetters>
          <RemoveNumbers>False</RemoveNumbers>
          <RemovePunctuation>True</RemovePunctuation>
          <ModifyCase>True</ModifyCase>
          <Case>TitleCase</Case>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Data Cleansing</Name></Annotation>
      </Properties>
    </Node>

    <!-- 7. Filter: positive quantity & non-null price -->
    <Node ToolID="7">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="560" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Mode>Custom</Mode>
          <Expression>ToNumber([quantity]) &gt; 0 AND !IsNull([unit_price])</Expression>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Filter Valid Rows</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFilter" />
    </Node>

    <!-- ============================================================ -->
    <!-- CONTAINER 2: Parsing & Enrichment                              -->
    <!-- ============================================================ -->
    <Node ToolID="200">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="950" y="30" width="1100" height="540" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>2. Parse, Join &amp; Enrich</Caption>
          <Style TextColor="#314c4a" FillColor="#e8e0d4" BorderColor="#314c4a" Transparency="50" Margin="25" />
        </Configuration>
        <Annotation DisplayMode="0" />
      </Properties>
      <ChildNodes>
        <Node ToolID="8" />
        <Node ToolID="9" />
        <Node ToolID="10" />
        <Node ToolID="11" />
        <Node ToolID="12" />
        <Node ToolID="13" />
        <Node ToolID="14" />
        <Node ToolID="15" />
        <Node ToolID="16" />
      </ChildNodes>
    </Node>

    <!-- 8. DateTime: parse transaction_date -->
    <Node ToolID="8">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DateTime.DateTime">
        <Position x="980" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <IsFrom>True</IsFrom>
          <InputFieldName>transaction_date</InputFieldName>
          <OutputFieldName>txn_dt</OutputFieldName>
          <Format>yyyy-MM-dd HH:mm:ss</Format>
          <Language>English</Language>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Parse Date</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDateTime" />
    </Node>

    <!-- 9. RegEx: parse product_code -->
    <Node ToolID="9">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RegEx.RegEx">
        <Position x="1100" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Field>product_code</Field>
          <CaseInsensitive>True</CaseInsensitive>
          <Method>ParseSimple</Method>
          <Expression>^([A-Z]{2,4})-(\d{3,5})-([A-Z0-9]{2,4})$</Expression>
          <ParseSimple>
            <FieldList>
              <Field name="pc_category" size="16" type="V_WString" />
              <Field name="pc_sku" size="16" type="V_WString" />
              <Field name="pc_variant" size="16" type="V_WString" />
            </FieldList>
          </ParseSimple>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Parse Product Code</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxRegEx" />
    </Node>

    <!-- 10. Formula: net_amount + date parts + amount_aud_eur -->
    <Node ToolID="10">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="1220" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="ToNumber([quantity]) * ToNumber([unit_price]) * (1 - ToNumber([discount_pct]))" field="net_amount" size="8" type="Double" />
            <FormulaField expression="[net_amount] * 0.62" field="net_amount_eur" size="8" type="Double" />
            <FormulaField expression="DateTimeYear([txn_dt])" field="txn_year" size="4" type="Int32" />
            <FormulaField expression="DateTimeMonth([txn_dt])" field="txn_month" size="4" type="Int32" />
            <FormulaField expression="ToDate([txn_dt])" field="txn_date_only" size="10" type="Date" />
            <FormulaField expression="IIF([is_weekend]=1, 'WK', 'WD')" field="day_type" size="2" type="V_WString" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Derive Fields</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <!-- 11. Text To Columns: split customer_name -->
    <Node ToolID="11">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextToColumns.TextToColumns">
        <Position x="1340" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Field>customer_name</Field>
          <Delimeters Token="False">,</Delimeters>
          <SplitMethod>Columns</SplitMethod>
          <NumFields>2</NumFields>
          <RootName>name_part</RootName>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Split Customer Name</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTextToColumns" />
    </Node>

    <!-- 12. Multi-Field Formula: trim all string fields -->
    <Node ToolID="12">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiFieldFormula.MultiFieldFormula">
        <Position x="1460" y="80" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Type>String</Type>
          <Fields>
            <Field name="name_part1" selected="True" />
            <Field name="name_part2" selected="True" />
            <Field name="payment_method" selected="True" />
          </Fields>
          <Expression>TrimLeft(TrimRight([_CurrentField_]))</Expression>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Trim Strings</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiFieldFormula" />
    </Node>

    <!-- 13. Join: transactions + products -->
    <Node ToolID="13">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Join.Join">
        <Position x="1580" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration joinByRecordPos="False">
          <JoinInfo connection="Left"><Field field="product_id" /></JoinInfo>
          <JoinInfo connection="Right"><Field field="product_id" /></JoinInfo>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Join Products</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxJoin" />
    </Node>

    <!-- 14. Find Replace: standardize product_name -->
    <Node ToolID="14">
      <GuiSettings Plugin="AlteryxBasePluginsGui.FindReplace.FindReplace">
        <Position x="1700" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FindWithinField>product_name</FindWithinField>
          <FindWhere>WholeString</FindWhere>
          <FindFieldRef>product_name_old</FindFieldRef>
          <ReplaceWith>True</ReplaceWith>
          <ReplaceFieldRef>product_name_new</ReplaceFieldRef>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Standardize Names</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFindReplace" />
    </Node>

    <!-- 15. Imputation: fill missing prices with median -->
    <Node ToolID="15">
      <GuiSettings Plugin="Imputation_v3">
        <Position x="1820" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Fields><Field name="unit_price" /></Fields>
          <IncomingValue type="Null" />
          <ReplaceValue type="Median" />
          <AddIndicator>True</AddIndicator>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Impute</Name></Annotation>
      </Properties>
    </Node>

    <!-- 16. Join: enriched txn + stores -->
    <Node ToolID="16">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Join.Join">
        <Position x="1940" y="120" />
      </GuiSettings>
      <Properties>
        <Configuration joinByRecordPos="False">
          <JoinInfo connection="Left"><Field field="store_id" /></JoinInfo>
          <JoinInfo connection="Right"><Field field="store_id" /></JoinInfo>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Join Stores</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxJoin" />
    </Node>

    <!-- ============================================================ -->
    <!-- CONTAINER 3: Customer Dedup (Fuzzy) + Grouping                -->
    <!-- ============================================================ -->
    <Node ToolID="300">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="30" y="600" width="900" height="380" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>3. Customer Dedup &amp; Grouping</Caption>
          <Style TextColor="#314c4a" FillColor="#e8d4d4" BorderColor="#314c4a" Transparency="50" Margin="25" />
        </Configuration>
        <Annotation DisplayMode="0" />
      </Properties>
      <ChildNodes>
        <Node ToolID="17" />
        <Node ToolID="18" />
        <Node ToolID="19" />
        <Node ToolID="20" />
        <Node ToolID="21" />
      </ChildNodes>
    </Node>

    <!-- 17. Unique: dedupe on transaction_id -->
    <Node ToolID="17">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Unique.Unique">
        <Position x="60" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <UniqueFields><Field field="transaction_id" /></UniqueFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Dedupe Txn ID</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxUnique" />
    </Node>

    <!-- 18. Fuzzy Match: customer_name (catch Smith vs Smyth) -->
    <Node ToolID="18">
      <GuiSettings Plugin="FuzzyMatch_v3">
        <Position x="200" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <MatchMode>Purge</MatchMode>
          <RecordIDField>row_id</RecordIDField>
          <SourceField>customer_id</SourceField>
          <MatchThreshold>80</MatchThreshold>
          <MatchFields>
            <MatchField fieldname="customer_name" matchstyle="Name" />
            <MatchField fieldname="email" matchstyle="Address" />
          </MatchFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Fuzzy Match Customers</Name></Annotation>
      </Properties>
    </Node>

    <!-- 19. Make Group: cluster equivalent customer records -->
    <Node ToolID="19">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MakeGroup.MakeGroup">
        <Position x="340" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <GroupIdField>customer_group_id</GroupIdField>
          <Fields>
            <Field name="row_id" />
            <Field name="row_id2" />
          </Fields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Make Group</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMakeGroup" />
    </Node>

    <!-- 20. Sort: by customer_group_id, txn_dt -->
    <Node ToolID="20">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sort.Sort">
        <Position x="480" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SortInfo>
            <Field field="customer_group_id" order="Ascending" />
            <Field field="txn_dt" order="Ascending" />
          </SortInfo>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Sort</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxSort" />
    </Node>

    <!-- 21. Multi-Row Formula: days since prior customer txn -->
    <Node ToolID="21">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiRowFormula.MultiRowFormula">
        <Position x="620" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <UpdateField>False</UpdateField>
          <CreateField>True</CreateField>
          <CreateFieldName>days_since_prior</CreateFieldName>
          <CreateFieldType>Int32</CreateFieldType>
          <CreateFieldSize>4</CreateFieldSize>
          <GroupByFields><Field field="customer_group_id" /></GroupByFields>
          <NumRows>1</NumRows>
          <ValuesForRowsThatDontExist>NULL</ValuesForRowsThatDontExist>
          <Expression>DateTimeDiff([txn_dt], [Row-1:txn_dt], 'days')</Expression>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Days Since Prior Txn</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiRowFormula" />
    </Node>

    <!-- ============================================================ -->
    <!-- CONTAINER 4: Geospatial (Stores + Trade Areas)                -->
    <!-- ============================================================ -->
    <Node ToolID="400">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="950" y="600" width="1100" height="380" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>4. Geospatial Analytics</Caption>
          <Style TextColor="#314c4a" FillColor="#d4d4e8" BorderColor="#314c4a" Transparency="50" Margin="25" />
        </Configuration>
        <Annotation DisplayMode="0" />
      </Properties>
      <ChildNodes>
        <Node ToolID="22" />
        <Node ToolID="23" />
        <Node ToolID="24" />
        <Node ToolID="25" />
        <Node ToolID="26" />
      </ChildNodes>
    </Node>

    <!-- 22. Formula: assign synthetic lat/lon to stores based on region -->
    <Node ToolID="22">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="980" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField field="store_lat" size="8" type="Double" expression="Switch([store_region], -33.86, 'AUS-NSW', -33.86, 'AUS-VIC', -37.81, 'AUS-QLD', -27.47, 'AUS-WA', -31.95, 'AUS-SA', -34.93, 'AUS-TAS', -42.88, 'AUS-ACT', -35.28, 'AUS-NT', -12.46)" />
            <FormulaField field="store_lon" size="8" type="Double" expression="Switch([store_region], 151.21, 'AUS-NSW', 151.21, 'AUS-VIC', 144.96, 'AUS-QLD', 153.03, 'AUS-WA', 115.86, 'AUS-SA', 138.60, 'AUS-TAS', 147.33, 'AUS-ACT', 149.13, 'AUS-NT', 130.84)" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Assign Lat/Lon</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>

    <!-- 23. Create Points: build SpatialObj from lat/lon -->
    <Node ToolID="23">
      <GuiSettings Plugin="AlteryxSpatialPluginsGui.CreatePoints.CreatePoints">
        <Position x="1120" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <LongFieldName>store_lon</LongFieldName>
          <LatFieldName>store_lat</LatFieldName>
          <OutputFieldName>store_point</OutputFieldName>
          <SR>WGS84</SR>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Create Store Points</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxSpatialPluginsEngine.dll" EngineDllEntryPoint="AlteryxCreatePoints" />
    </Node>

    <!-- 24. Buffer: 5 km trade area around each store -->
    <Node ToolID="24">
      <GuiSettings Plugin="AlteryxSpatialPluginsGui.Buffer.Buffer">
        <Position x="1260" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SpatialField>store_point</SpatialField>
          <BufferDistance>5</BufferDistance>
          <BufferUnits>Kilometers</BufferUnits>
          <OutputFieldName>store_trade_area</OutputFieldName>
        </Configuration>
        <Annotation DisplayMode="0"><Name>5km Buffer (Trade Area)</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxSpatialPluginsEngine.dll" EngineDllEntryPoint="AlteryxBuffer" />
    </Node>

    <!-- 25. Find Nearest: nearest store per transaction (via synthetic txn-point) -->
    <Node ToolID="25">
      <GuiSettings Plugin="FindNearest_v3">
        <Position x="1400" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <TargetField>store_point</TargetField>
          <UniverseField>store_point</UniverseField>
          <MaxDistance>50</MaxDistance>
          <MaxDistanceUnits>Kilometers</MaxDistanceUnits>
          <NumberOfNeighbors>3</NumberOfNeighbors>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Find Nearest 3 Stores</Name></Annotation>
      </Properties>
    </Node>

    <!-- 26. Spatial Match: which transactions fall in which trade area -->
    <Node ToolID="26">
      <GuiSettings Plugin="AlteryxSpatialPluginsGui.SpatialMatch.SpatialMatch">
        <Position x="1540" y="650" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <UniverseField>store_trade_area</UniverseField>
          <TargetField>store_point</TargetField>
          <MatchType>Intersects</MatchType>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Spatial Match Txn->Area</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxSpatialPluginsEngine.dll" EngineDllEntryPoint="AlteryxSpatialMatch" />
    </Node>

    <!-- ============================================================ -->
    <!-- CONTAINER 5: Aggregation + Stats                              -->
    <!-- ============================================================ -->
    <Node ToolID="500">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="30" y="1010" width="900" height="380" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>5. Aggregation, Stats &amp; Pivots</Caption>
          <Style TextColor="#314c4a" FillColor="#e8e8d4" BorderColor="#314c4a" Transparency="50" Margin="25" />
        </Configuration>
        <Annotation DisplayMode="0" />
      </Properties>
      <ChildNodes>
        <Node ToolID="27" />
        <Node ToolID="28" />
        <Node ToolID="29" />
        <Node ToolID="30" />
        <Node ToolID="31" />
        <Node ToolID="32" />
        <Node ToolID="33" />
      </ChildNodes>
    </Node>

    <!-- 27. Count Records -->
    <Node ToolID="27">
      <GuiSettings Plugin="AlteryxBasePluginsGui.CountRecords.CountRecords">
        <Position x="60" y="1060" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FieldName>total_txn_count</FieldName>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Count Records</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxCountRecords" />
    </Node>

    <!-- 28. Running Total: cumulative store sales -->
    <Node ToolID="28">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RunningTotal.RunningTotal">
        <Position x="200" y="1060" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <GroupByFields><Field field="store_id" /></GroupByFields>
          <RunningTotalFields><Field field="net_amount" /></RunningTotalFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Running Store Sales</Name></Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxRunningTotal" />
    </Node>

    <!-- 29. Weighted Average: basket size weighted by quantity per region -->
    <Node ToolID="29">
      <GuiSettings Plugin="AlteryxBasePluginsGui.WeightedAverage.WeightedAverage">
        <Position x="340" y="1060" />
      </GuiSettings>
      <Properties>
        <Configuration>
