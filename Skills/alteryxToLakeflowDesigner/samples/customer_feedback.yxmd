<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2024.1">
  <!--
    Synthetic Alteryx workflow for the Lakeflow Designer conversion demo.
    Inputs:
      - /Volumes/aldi_aus/aldi_us/test/current_feedback.csv  (file)
      - /Volumes/aldi_aus/aldi_us/test/historical_feedback.csv (file)
      - aldi_aus.aldi_us.products (UC table)
    Output:
      - aldi_aus.aldi_us.gold_feedback_summary
  -->

  <Nodes>

    <!-- Tool Container = Designer 'group' -->
    <Node ToolID="100">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="60" y="60" width="980" height="520"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>AI Enrichment Branch</Caption>
        </Configuration>
        <Annotation DisplayMode="0"><DefaultAnnotationText>AI Enrichment Branch</DefaultAnnotationText></Annotation>
      </Properties>
    </Node>

    <!-- Comment = Designer 'markdown' -->
    <Node ToolID="200">
      <GuiSettings Plugin="AlteryxGuiToolkit.TextBox.TextBox">
        <Position x="60" y="-180" width="500" height="200"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Text># Customer Feedback Pipeline

Combines current and historical feedback, enriches with AI (sentiment, extraction, masking),
joins to the product catalog, aggregates per category, ranks, and writes the result to the
gold table for downstream BI use.</Text>
        </Configuration>
      </Properties>
    </Node>

    <!-- Input 1: current_feedback.csv -->
    <Node ToolID="1" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="100" y="120"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords/>
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="0">/Volumes/aldi_aus/aldi_us/test/current_feedback.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <FieldLen>254</FieldLen>
            <CodePage>65001</CodePage>
            <Delimeter>,</Delimeter>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0"><Name>current_feedback.csv</Name></Annotation>
      </Properties>
    </Node>

    <!-- Input 2: historical_feedback.csv -->
    <Node ToolID="2" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="100" y="240"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords/>
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="0">/Volumes/aldi_aus/aldi_us/test/historical_feedback.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>
            <FieldLen>254</FieldLen>
            <CodePage>65001</CodePage>
            <Delimeter>,</Delimeter>
          </FormatSpecificOptions>
        </Configuration>
        <Annotation DisplayMode="0"><Name>historical_feedback.csv</Name></Annotation>
      </Properties>
    </Node>

    <!-- Input 3: products UC table -->
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="100" y="660"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Passwords/>
          <File OutputFileName="" RecordLimit="" FileFormat="22">aldi_aus.aldi_us.products</File>
        </Configuration>
        <Annotation DisplayMode="0"><Name>products (UC)</Name></Annotation>
      </Properties>
    </Node>

    <!-- Union of current + historical -->
    <Node ToolID="10" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Union.Union">
        <Position x="240" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration><Mode>ByName</Mode><SetOutputOrder>False</SetOutputOrder></Configuration>
        <Annotation DisplayMode="0"><Name>Union all feedback</Name></Annotation>
      </Properties>
    </Node>

    <!-- Filter: rating BETWEEN 1 AND 5 AND comment IS NOT NULL -->
    <Node ToolID="20" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="360" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Mode>Custom</Mode>
          <Expression>[rating] &gt;= 1 AND [rating] &lt;= 5 AND [comment] IS NOT NULL</Expression>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Valid feedback only</Name></Annotation>
      </Properties>
    </Node>

    <!-- Select: cast types and rename -->
    <Node ToolID="30" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.AlteryxSelect.AlteryxSelect">
        <Position x="480" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <SelectFields>
            <SelectField field="customer_id" selected="True" type="Int32"/>
            <SelectField field="product_id" selected="True" type="Int32"/>
            <SelectField field="rating" selected="True" type="Int32"/>
            <SelectField field="comment" selected="True" type="V_WString"/>
            <SelectField field="feedback_date" selected="True" type="Date"/>
          </SelectFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Cast and rename</Name></Annotation>
      </Properties>
    </Node>

    <!-- Sentiment Analysis (predictive) → maps to ai_function ai_analyze_sentiment -->
    <Node ToolID="40" ParentID="100">
      <GuiSettings Plugin="Predictive.SentimentAnalysis">
        <Position x="600" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <TextField>comment</TextField>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Sentiment</Name></Annotation>
      </Properties>
    </Node>

    <!-- RegEx parse for entity extraction → maps to ai_extract -->
    <Node ToolID="50" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.RegEx.RegEx">
        <Position x="720" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Field>comment</Field>
          <Operation>Match</Operation>
          <Pattern>(\b[\w.-]+@[\w.-]+\b|\b\d{4}-\d{3}-\d{3}\b)</Pattern>
          <Output>extracted_entities</Output>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Extract entities</Name></Annotation>
      </Properties>
    </Node>

    <!-- Data Cleansing (PII redaction) → maps to ai_mask -->
    <Node ToolID="60" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DataCleansing.DataCleansing">
        <Position x="840" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Field field="comment"/>
          <RemovePII>True</RemovePII>
          <Entities>EMAIL,PHONE,PERSON</Entities>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Mask PII</Name></Annotation>
      </Properties>
    </Node>

    <!-- Python tool: compute weighted score -->
    <Node ToolID="70" ParentID="100">
      <GuiSettings Plugin="JupyterCode.JupyterCode">
        <Position x="960" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <JupyterProductionModeScript>
# Weighted feedback score: rating * (1 + sentiment_score)
from ayx import Alteryx
import pandas as pd
df = Alteryx.read("#1")
df["weighted_score"] = df["rating"] * (1 + df["sentiment_score"].fillna(0))
Alteryx.write(df, 1)
          </JupyterProductionModeScript>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Weighted score (Python)</Name></Annotation>
      </Properties>
    </Node>

    <!-- Multi-Row Formula → maps to sql ROW_NUMBER dedup -->
    <Node ToolID="80" ParentID="100">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiRowFormula.MultiRowFormula">
        <Position x="1080" y="180"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <UpdateField>_dedup_rn</UpdateField>
          <CreateField>True</CreateField>
          <FieldType>Int32</FieldType>
          <GroupByFields><Field name="customer_id"/><Field name="product_id"/></GroupByFields>
          <OrderByFields><Field name="feedback_date" order="Desc"/></OrderByFields>
          <Expression>[Row-1:_dedup_rn]+1</Expression>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Dedup ROW_NUMBER</Name></Annotation>
      </Properties>
    </Node>

    <!-- Join: feedback × products on product_id -->
    <Node ToolID="90">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Join.Join">
        <Position x="1240" y="420"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <JoinInfo connection="Left"><Field field="product_id"/></JoinInfo>
          <JoinInfo connection="Right"><Field field="product_id"/></JoinInfo>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Join products (LEFT)</Name></Annotation>
      </Properties>
    </Node>

    <!-- Summarize: per-category metrics -->
    <Node ToolID="110">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Summarize.Summarize">
        <Position x="1380" y="420"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <SummarizeFields>
            <SummarizeField field="category" action="GroupBy"/>
            <SummarizeField field="weighted_score" action="Avg" rename="avg_weighted_score"/>
            <SummarizeField field="rating" action="Avg" rename="avg_rating"/>
            <SummarizeField field="rating" action="Count" rename="feedback_count"/>
            <SummarizeField field="weighted_score" action="Median" rename="median_weighted_score"/>
            <SummarizeField field="weighted_score" action="Sum" rename="sum_weighted_score"/>
          </SummarizeFields>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Aggregate by category</Name></Annotation>
      </Properties>
    </Node>

    <!-- CrossTab: distribution of ratings (1..5) per category -->
    <Node ToolID="120">
      <GuiSettings Plugin="AlteryxBasePluginsGui.CrossTab.CrossTab">
        <Position x="1500" y="420"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <GroupFields><Field name="category"/></GroupFields>
          <HeaderField>rating</HeaderField>
          <DataField>rating</DataField>
          <Methods><Method>Count</Method></Methods>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Pivot rating distribution</Name></Annotation>
      </Properties>
    </Node>

    <!-- Sort: avg_weighted_score DESC -->
    <Node ToolID="130">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sort.Sort">
        <Position x="1620" y="420"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <SortInfo><Field field="avg_weighted_score" order="Desc"/></SortInfo>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Sort by avg score</Name></Annotation>
      </Properties>
    </Node>

    <!-- Sample: top 10 -->
    <Node ToolID="140">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sample.Sample">
        <Position x="1740" y="420"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Mode>FirstN</Mode>
          <N>10</N>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Top 10</Name></Annotation>
      </Properties>
    </Node>

    <!-- Output: gold table -->
    <Node ToolID="150">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="1860" y="420"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File OutputFileName="" FileFormat="22">aldi_aus.aldi_us.gold_feedback_summary</File>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Output gold table</Name></Annotation>
      </Properties>
    </Node>

  </Nodes>

  <Connections>
    <Connection><Origin ToolID="1"  Connection="Output"/><Destination ToolID="10" Connection="Input1"/></Connection>
    <Connection><Origin ToolID="2"  Connection="Output"/><Destination ToolID="10" Connection="Input2"/></Connection>
    <Connection><Origin ToolID="10" Connection="Output"/><Destination ToolID="20" Connection="Input"/></Connection>
    <Connection><Origin ToolID="20" Connection="True"  /><Destination ToolID="30" Connection="Input"/></Connection>
    <Connection><Origin ToolID="30" Connection="Output"/><Destination ToolID="40" Connection="Input"/></Connection>
    <Connection><Origin ToolID="40" Connection="Output"/><Destination ToolID="50" Connection="Input"/></Connection>
    <Connection><Origin ToolID="50" Connection="Output"/><Destination ToolID="60" Connection="Input"/></Connection>
    <Connection><Origin ToolID="60" Connection="Output"/><Destination ToolID="70" Connection="Input"/></Connection>
    <Connection><Origin ToolID="70" Connection="Output"/><Destination ToolID="80" Connection="Input"/></Connection>
    <Connection><Origin ToolID="80" Connection="Output"/><Destination ToolID="90" Connection="Left"/></Connection>
    <Connection><Origin ToolID="3"  Connection="Output"/><Destination ToolID="90" Connection="Right"/></Connection>
    <Connection><Origin ToolID="90" Connection="Join"  /><Destination ToolID="110" Connection="Input"/></Connection>
    <Connection><Origin ToolID="110" Connection="Output"/><Destination ToolID="120" Connection="Input"/></Connection>
    <Connection><Origin ToolID="120" Connection="Output"/><Destination ToolID="130" Connection="Input"/></Connection>
    <Connection><Origin ToolID="130" Connection="Output"/><Destination ToolID="140" Connection="Input"/></Connection>
    <Connection><Origin ToolID="140" Connection="Output"/><Destination ToolID="150" Connection="Input"/></Connection>
  </Connections>

</AlteryxDocument>
